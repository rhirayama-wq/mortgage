# ローカル開発用（supabase start の出力値を設定する）
# 本番シークレットをここに書かない。 .env.local は git 管理外。
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
# サーバー専用。NEXT_PUBLIC_ を付けてはならない（CLAUDE.md §23）。
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# メールリンクに使う自アプリ origin（Host ヘッダを信頼しないため明示設定）
APP_ORIGIN=http://localhost:3000
